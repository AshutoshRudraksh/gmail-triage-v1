# Copy this file to .env and fill in the values.
# Never commit .env, secrets/credentials.json, or secrets/token.json.

# Vercel AI Gateway key used as the Jev bearer token.
# Create it at https://vercel.com/dashboard (AI Gateway, API keys).
AI_GATEWAY_API_KEY=

# Path to the Google OAuth desktop client JSON from Google Cloud Console.
# Enable Gmail API, create an OAuth client (Desktop app), and download the file here.
GOOGLE_CLIENT_SECRET_PATH=secrets/credentials.json

# Path where the authorized Gmail token is stored after the first browser login.
GOOGLE_TOKEN_PATH=secrets/token.json

# Optional local state directory. Defaults to .triage
# TRIAGE_STATE_DIR=.triage
