#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import sys
from contextlib import redirect_stderr, redirect_stdout
from io import StringIO
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from common import evidence_dir, new_run_id, reexec_venv, repo_root, run_dir, write_text

reexec_venv()
ROOT = repo_root()
sys.path.insert(0, str(ROOT))

from tests.fakes import FakeGmail, FakeJev, answers
from triage import dry_run
from triage.models import Checkpoint
from triage.persistence import StateStore


def main() -> int:
    run_id = new_run_id()
    scratch = run_dir(run_id)
    evidence = evidence_dir("dry-run-digest", run_id)
    state_dir = scratch / "state"
    env_file = scratch / ".env"
    write_text(env_file, "AI_GATEWAY_API_KEY=verify-not-a-secret\n")
    store = StateStore(state_dir)
    store.write_checkpoint(Checkpoint("1"))
    gmail = FakeGmail(
        {
            "users.history.list": [
                {
                    "history": [
                        {
                            "id": "2",
                            "messagesAdded": [
                                {"message": {"id": "m", "threadId": "t", "labelIds": ["INBOX"]}}
                            ],
                        }
                    ]
                }
            ],
            "users.labels.list": [{"labels": []}],
            "users.messages.get": [
                {
                    "id": "m",
                    "threadId": "t",
                    "labelIds": ["INBOX"],
                    "snippet": "hello",
                    "payload": {
                        "headers": [
                            {"name": "From", "value": "a@example.com"},
                            {"name": "Subject", "value": "Hi"},
                        ]
                    },
                }
            ],
        }
    )
    for name in (
        "AI_GATEWAY_API_KEY",
        "GOOGLE_CLIENT_SECRET_PATH",
        "GOOGLE_TOKEN_PATH",
        "TRIAGE_STATE_DIR",
        "TRIAGE_ENV_FILE",
    ):
        os.environ.pop(name, None)
    os.environ["TRIAGE_ENV_FILE"] = str(env_file)
    os.environ["TRIAGE_STATE_DIR"] = str(state_dir)
    dry_run.client_from_environment = lambda mode: gmail
    dry_run.JevClient = lambda key: FakeJev(answers())
    write_text(
        evidence / "command.txt",
        "helpers/drive-dry-run -> triage.dry_run.main(['--limit', '50'])\n",
    )
    stdout = StringIO()
    stderr = StringIO()
    with redirect_stdout(stdout), redirect_stderr(stderr):
        code = dry_run.main(["--limit", "50"])
    out = stdout.getvalue()
    err = stderr.getvalue()
    write_text(evidence / "stdout.txt", out)
    write_text(evidence / "stderr.txt", err)
    write_text(evidence / "exit_code.txt", f"{code}\n")
    digest_path = state_dir / "digest.txt"
    digest = digest_path.read_text(encoding="utf-8") if digest_path.is_file() else ""
    write_text(evidence / "digest.txt", digest)
    write_text(
        evidence / "gmail_calls.json",
        json.dumps([{"method": method} for method, _ in gmail.calls], indent=2) + "\n",
    )
    mutating = [
        method
        for method, _ in gmail.calls
        if method
        in {
            "users.messages.modify",
            "users.labels.create",
            "users.messages.trash",
            "users.messages.send",
        }
    ]
    write_text(evidence / "mutating_methods.txt", ("\n".join(mutating) + "\n") if mutating else "")
    ok = (
        code == 0
        and "Gmail Triage Digest" in out
        and "https://mail.google.com/mail/u/0/#all/t" in digest
        and "sender" not in digest.lower()
        and not mutating
    )
    write_text(evidence / "result.txt", "pass\n" if ok else "fail\n")
    print(evidence)
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())
